# Keep code, configuration, metadata, and reports in ordinary Git.
# Large numerical and mesh assets are stored in Git LFS.
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Scope image tracking to project assets, preserving existing scratch-file history.
artifacts/**/*.png filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.jpg filter=lfs diff=lfs merge=lfs -text
artifacts/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
output/**/*.png filter=lfs diff=lfs merge=lfs -text
output/**/*.jpg filter=lfs diff=lfs merge=lfs -text
output/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
chandrayaan-3-navcam-sorted/**/*.png filter=lfs diff=lfs merge=lfs -text
chandrayaan-3-navcam-sorted/**/*.jpg filter=lfs diff=lfs merge=lfs -text
chandrayaan-3-documentation/**/*.pdf filter=lfs diff=lfs merge=lfs -text
output/**/*.pdf filter=lfs diff=lfs merge=lfs -text

# Per-pixel calibration tables are large text arrays; CAHV camera files stay readable.
chandrayaan-3-documentation/nav/calibration/*_gain.txt filter=lfs diff=lfs merge=lfs -text
chandrayaan-3-documentation/nav/calibration/*_offset.txt filter=lfs diff=lfs merge=lfs -text
