  "dark_threshold": 5,
  "saturated_threshold": 250,
  "texture_std_threshold": 2.0,
  "texture_window": 7,
  "mesh_stride": 3,
  "mesh_max_relative_depth_jump": 0.02,
  "mesh_max_edge_baselines": 0.25,
  "clahe_clip_limit": 2.0,
  "clahe_grid": 8,
  "random_seed": 42
}
