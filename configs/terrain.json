{
  "family": "NC",
  "preprocessing": "none",
  "interpretation": "literal",
  "min_disparity": 0,
  "num_disparities": 512,
  "pad_search": true,
  "raw_quality_mask": true,
  "block_size": 5,
  "uniqueness_ratio": 15,
  "speckle_window_size": 100,
